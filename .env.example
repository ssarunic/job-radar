# Local environment for the Job Search Assistant.
# Copy to `.env` (gitignored) and fill in — never commit secrets.
# Read by BOTH the CLI (auto-loaded at startup) and docker-compose.

# Slack Incoming Webhook for new-role notifications (set notify.provider: slack
# and notify.enabled: true in config/settings.yaml). Create one at
# https://api.slack.com/apps -> Incoming Webhooks. Treat it like a password.
SLACK_WEBHOOK_URL=

# Web app base URL used for deep links in Slack messages (role title -> /jobs/<id>).
# e.g. https://<pi-host>.<tailnet>.ts.net:8765  (blank -> links the external posting)
WEB_BASE_URL=

# Anthropic API key — only needed if use_claude: true in config/settings.yaml.
ANTHROPIC_API_KEY=

# Only for the Pi/production compose (deploy/docker-compose.yml): extra Host
# header values the /mcp endpoint answers to (comma list, "host:*" wildcards the
# port). Set to the box's tailnet names, e.g.
#   <pi-host>:*,<pi-host>.<tailnet>.ts.net:*,<pi-host>.<tailnet>.ts.net
# Leave blank for local use (localhost is always allowed).
JSA_MCP_ALLOWED_HOSTS=
