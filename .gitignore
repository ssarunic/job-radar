# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# web app build artifacts
webapp/frontend/node_modules/
webapp/frontend/dist/
webapp/backend/.venv/
uv.lock

# OS
.DS_Store

# Editor / agent-local settings (keep committed skills under .claude/skills/)
.claude/*
!.claude/skills/
.idea/
.vscode/

# Secrets / local overrides
.env
config/settings.local.yaml

# Your followed-company list — personal, created on first follow
# (see config/companies.example.csv for the format).
config/companies.csv

# Generated runtime output — regenerable, kept local (not versioned).
# Directories are preserved via .gitkeep.
jobs/*
!jobs/.gitkeep
companies/*
!companies/.gitkeep
data/*
!data/.gitkeep
